# GrimIron Environment Variables Configuration
# Public Supabase credentials for cloud battle syncing and multiplayer accounts.
# Note: GrimIron is fully functional offline without Supabase (local SQLite engine).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
